# koru-os lib/koruelf: forked app-elfloader load path (Q32).
# Included with KORUELF_DIR set. Requires libelf, posix-mmap, ukbinfmt.
APPKORUOS_SRCS-y += $(KORUELF_DIR)/elf_load.c
APPKORUOS_SRCS-y += $(KORUELF_DIR)/elf_ctx.c
APPKORUOS_SRCS-y += $(KORUELF_DIR)/elf_binfmt.c
APPKORUOS_CINCLUDES-y += -I$(KORUELF_DIR)
# Pretend we are app-elfloader for its CONFIG_APPELFLOADER_* symbols.
APPKORUOS_CFLAGS-y += -DCONFIG_APPELFLOADER_VFSEXEC=1
APPKORUOS_CFLAGS-y += -DCONFIG_APPELFLOADER_VFSEXEC_EXECBIT=1
APPKORUOS_CFLAGS-y += -DCONFIG_APPELFLOADER_ELF_BINFMT=1
APPKORUOS_CFLAGS-y += -UCONFIG_APPELFLOADER_VDSO
APPKORUOS_CFLAGS-y += -DCONFIG_APPELFLOADER_VDSO=0
