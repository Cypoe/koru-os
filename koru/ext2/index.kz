// koruos/ext2: a minimal, allocating ext2 driver as a Koru lift (DESIGN-0001 M2, DoD-1).
//
// Scope, deliberately small and refused loudly outside it:
//   - revision 1 ext2, 1 KiB blocks, 128-byte inodes, exactly one block group;
//   - incompat features: none, or only FILETYPE; ro_compat: none or SPARSE_SUPER/LARGE_FILE
//     (neither changes anything this driver writes in a one-group filesystem);
//   - create: one regular file in the root directory, at most 12 blocks (direct only),
//     the name must fit in the root directory's first block.
//   - reads follow indirect blocks (i_block[12] single, i_block[13]
//     double): up to ~66 MiB; triple-indirect refuses by name.
// It allocates an inode and data blocks from the on-disk bitmaps and updates the group
// descriptor and superblock free counts. The host checks the result with e2fsck/debugfs.
//
// Phantom states: mount mints <mounted!>; create/read need <!mounted> and re-mint it;
// unmount discharges it (flush + ukblkdev stop/unconfigure).
//
// Block access copies the ukblkdev call sequence of koru-libs unikraft/blk @ ff5cb559
// (get → configure → queue_configure → start, submit_one + finish_reqs). The blk lift
// exposes no byte-level API another lift could call, so the sequence is repeated
// here. That is debt, recorded in experiments/m2-ext2/README.md.

~import std/realize
~import koruos/realize

// realize row: which arms can serve this lift and how — a typed declaration,
// harvested by the realize command (DESIGN-0001 §11.1). No linuxu binding —
// virtio-pci/blk is a KVM-plat device, not host syscalls.
~std/realize:row(iface: koruos/ext2) {
    "stack": 8192,
    "resources": "blkdev: uk_blkdev queue ops over virtio-blk; heap: malloc/memalign/free",
    "evidence": "V: koru/ext2/index.kz externs uk_blkdev_*/malloc/memalign; M2 author lines name the LIBVIRTIO deltas now derived here",
    "binds": [
        { "arm": "unikraft/qemu-x86_64", "mechanism": "kconfig", "deltas": ["CONFIG_LIBUKBLKDEV=y", "CONFIG_LIBVIRTIO_BLK=y", "CONFIG_LIBVIRTIO_PCI=y", "CONFIG_LIBVIRTIO_BUS=y"] },
        { "arm": "koru-native", "mechanism": "native-runtime", "deltas": ["provisional: legacy virtio-blk (transitional PCI, I/O-port window), one virtqueue, interrupt-acked ISR, used ring polled for data, no modern-capability negotiation"] },
        { "arm": "hosted", "mechanism": "host-libc", "deltas": ["src:koru/hosted/linux.zig", "blkdev: host file at $KORU_BLK0, requests complete inline in submit_one (no IRQ/park story)"] }
    ]
}

const std = @import("std");

const UkBlkdev = opaque {};
const UkAlloc = opaque {};
extern var _uk_alloc_head: ?*UkAlloc;
extern fn uk_blkdev_get(id: c_uint) ?*UkBlkdev;
extern fn uk_blkdev_configure(dev: *UkBlkdev, conf: *const BlkConf) c_int;
extern fn uk_blkdev_queue_get_info(dev: *UkBlkdev, queue_id: u16, q_info: *QueueInfo) c_int;
extern fn uk_blkdev_queue_configure(dev: *UkBlkdev, queue_id: u16, nb_desc: u16, conf: *const QueueConf) c_int;
extern fn uk_blkdev_start(dev: *UkBlkdev) c_int;
extern fn uk_blkdev_queue_finish_reqs(dev: *UkBlkdev, queue_id: u16) c_int;
extern fn uk_blkdev_queue_submit_one(dev: *UkBlkdev, queue_id: u16, req: *BlkReq) c_int;
extern fn uk_blkdev_stop(dev: *UkBlkdev) c_int;
extern fn uk_blkdev_queue_unconfigure(dev: *UkBlkdev, queue_id: u16) c_int;
extern fn uk_blkdev_unconfigure(dev: *UkBlkdev) c_int;
extern fn malloc(size: usize) ?*anyopaque;
extern fn free(ptr: ?*anyopaque) void;
extern fn memalign(alignment: usize, size: usize) ?*anyopaque;


const BlkConf = extern struct { nb_queues: u16 };
const QueueInfo = extern struct { nb_max: u16, nb_min: u16, nb_align: u16, nb_is_power_of_two: c_int };
const QueueConf = extern struct {
    a: ?*UkAlloc,
    callback: ?*const fn (*UkBlkdev, u16, ?*anyopaque) callconv(.c) void,
    callback_cookie: ?*anyopaque,
};
const Cap = extern struct { sectors: usize, ssize: usize, mode: c_int, max_sectors_per_req: usize, ioalign: u16 };
const BlkPub = extern struct { submit_one: ?*anyopaque, finish_reqs: ?*anyopaque, _data: ?*anyopaque, capabilities: Cap };
const BlkReq = extern struct {
    operation: c_int, start_sector: usize, nb_sectors: usize, aio_buf: ?*anyopaque,
    cb: ?*const fn (*BlkReq, ?*anyopaque) callconv(.c) void, cb_cookie: ?*anyopaque, state: c_int, result: c_int,
};
comptime {
    if (@sizeOf(Cap) != 40 or @offsetOf(BlkPub, "capabilities") != 24) @compileError("ukblkdev layout changed");
    if (@sizeOf(BlkReq) != 56 or @offsetOf(BlkReq, "state") != 48) @compileError("uk_blkreq layout changed");
}
const OP_READ: c_int = 0;
const OP_WRITE: c_int = 1;
const OP_FFLUSH: c_int = 4;
const REQ_FINISHED: c_int = 0;
const REQ_UNFINISHED: c_int = 1;
const STATUS_SUCCESS: c_int = 0x1;
const BS: usize = 1024;

const Fs = struct {
    dev: *UkBlkdev,
    dev_id: u32,
    buf: [*]u8, // one block, device-aligned staging
    spb: usize, // sectors per block
    sectors: usize,
    sb: [BS]u8,
    bgd: [BS]u8,
    inodes_count: u32,
    blocks_count: u32,
    first_data_block: u32,
    inodes_per_group: u32,
    blocks_per_group: u32,
    first_ino: u32,
    filetype: bool,
    block_bitmap: u32,
    inode_bitmap: u32,
    inode_table: u32,
    // The child's fs-view ops record lives IN the Fs — built once at
    // mount, dead at unmount. &fs.vfs is what spawn hands the child's
    // address space; a stack-local copy would be borrowed scratch whose
    // lifetime silently depends on exec staying synchronous.
    vfs: ChildFsOps,
};

// The mounted-provider table exec-by-nid walks: pin → key → dev → the
// live mounted Fs. mount registers on success, unmount deregisters
// BEFORE freeing — a pin outlives its provider's mount and the refusal
// says so, never a dangling *Fs.
var mounted: [8]?*Fs = .{null} ** 8;

fn rd32(b: []const u8, off: usize) u32 { return std.mem.readInt(u32, b[off..][0..4], .little); }
fn rd16(b: []const u8, off: usize) u16 { return std.mem.readInt(u16, b[off..][0..2], .little); }
fn wr32(b: []u8, off: usize, v: u32) void { std.mem.writeInt(u32, b[off..][0..4], v, .little); }
fn wr16(b: []u8, off: usize, v: u16) void { std.mem.writeInt(u16, b[off..][0..2], v, .little); }

fn xfer(fs: *Fs, op: c_int, block: u32, nb_sectors: usize) c_int {
    var req = BlkReq{ .operation = op, .start_sector = @as(usize, block) * fs.spb, .nb_sectors = nb_sectors,
        .aio_buf = @ptrCast(fs.buf), .cb = null, .cb_cookie = null, .state = REQ_UNFINISHED, .result = 0 };
    const st = uk_blkdev_queue_submit_one(fs.dev, 0, &req);
    if (st < 0) return st;
    if ((st & STATUS_SUCCESS) == 0) return -5;
    while (@atomicLoad(c_int, &req.state, .acquire) != REQ_FINISHED) {
        const rc = uk_blkdev_queue_finish_reqs(fs.dev, 0);
        if (rc < 0) return rc;
    }
    return req.result;
}
fn readBlock(fs: *Fs, block: u32, out: []u8) bool {
    if (xfer(fs, OP_READ, block, fs.spb) != 0) return false;
    @memcpy(out[0..BS], fs.buf[0..BS]);
    return true;
}
fn writeBlock(fs: *Fs, block: u32, in: []const u8) bool {
    @memcpy(fs.buf[0..BS], in[0..BS]);
    return xfer(fs, OP_WRITE, block, fs.spb) == 0;
}

// inode → (block, offset) through the group descriptor table — inos are
// numbered contiguously ACROSS groups, so group membership is
// (ino-1)/inodes_per_group and the inode table block comes from that
// group's descriptor, not a cached single value. The GDT lives at
// first_data_block+1 (32B entries, BS/32 groups per GDT block).
fn inodeLoc(fs: *Fs, ino: u32) ?struct { block: u32, off: usize } {
    const g = (ino - 1) / fs.inodes_per_group;
    const idx = (ino - 1) % fs.inodes_per_group;
    var gdb: [BS]u8 = undefined;
    if (!readBlock(fs, fs.first_data_block + 1 + g / @as(u32, BS / 32), &gdb)) return null;
    const itable = rd32(&gdb, (g % (BS / 32)) * 32 + 8);
    const byte = @as(usize, idx) * 128;
    return .{ .block = itable + @as(u32, @intCast(byte / BS)), .off = byte % BS };
}

// Find `name` inside directory inode `dir_ino` — scans every direct block,
// not just the first. Refuses (null) if the inode isn't a directory —
// a non-dir mid-path component is a failed walk, not a skipped check.
fn dirFind(fs: *Fs, dir_ino: u32, name: []const u8, dirblk: []u8) ?u32 {
    var ib: [BS]u8 = undefined;
    const loc = inodeLoc(fs, dir_ino) orelse return null;
    if (!readBlock(fs, loc.block, &ib)) return null;
    if (rd16(&ib, loc.off + 0) & 0o170000 != 0o040000) return null;
    for (0..12) |i| {
        const blkno = rd32(&ib, loc.off + 40 + i * 4);
        if (blkno == 0) continue;
        if (!readBlock(fs, blkno, dirblk)) return null;
        var p: usize = 0;
        while (p < BS) {
            const ino = rd32(dirblk, p);
            const rec = rd16(dirblk, p + 4);
            if (rec < 8) return null;
            const nl: usize = if (fs.filetype) dirblk[p + 6] else rd16(dirblk, p + 6);
            if (ino != 0 and nl == name.len and std.mem.eql(u8, dirblk[p + 8 .. p + 8 + nl], name)) return ino;
            p += rec;
        }
    }
    return null;
}

// Path → inode: components walk from the root inode (2), '/'-separated,
// empty components skipped. The inode number is the stable identity —
// the path is one projection over it (the POSIX view).
fn lookupPath(fs: *Fs, path: []const u8, dirblk: []u8) ?u32 {
    var ino: u32 = 2;
    var it = std.mem.splitScalar(u8, path, '/');
    while (it.next()) |comp| {
        if (comp.len == 0) continue;
        if (comp.len > 255) return null;
        ino = dirFind(fs, ino, comp, dirblk) orelse return null;
    }
    return ino;
}

// Split "a/b/c" into the parent directory's path and the leaf name —
// every path-mutating op (create/unlink/rename) mutates a directory,
// never the leaf itself, and the grant names that directory's object.
fn splitPath(path: []const u8) struct { dir: []const u8, leaf: []const u8 } {
    if (std.mem.lastIndexOfScalar(u8, path, '/')) |i| {
        const leaf = path[i + 1 ..];
        if (i == 0) return .{ .dir = "", .leaf = leaf }; // "/x" → root
        return .{ .dir = path[0..i], .leaf = leaf };
    }
    return .{ .dir = "", .leaf = path };
}

fn entryNl(fs: *Fs, blk: []const u8, p: usize) usize {
    return if (fs.filetype) blk[p + 6] else rd16(blk, p + 6);
}

// Insert a name → ino entry into a directory inode. Scans every direct
// block for an entry whose rec_len exceeds its real size — the slack
// splits in two, the tail carrying the new name. No slack anywhere:
// grow the directory by one freshly-allocated block (i_size += BS).
// Refuses when the name collides, the dir is out of direct blocks, or
// the leaf is "."/".." — mutating those is never a caller's verb.
fn dirAdd(fs: *Fs, dir_ino: u32, name: []const u8, ino: u32, ftype: u8) bool {
    if (name.len == 0 or name.len > 255) return false;
    if (std.mem.eql(u8, name, ".") or std.mem.eql(u8, name, "..")) return false;
    var scratch: [BS]u8 = undefined;
    if (dirFind(fs, dir_ino, name, &scratch) != null) return false; // EEXIST
    const need: usize = (8 + name.len + 3) & ~@as(usize, 3);
    const loc = inodeLoc(fs, dir_ino) orelse return false;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return false;
    var blk: [BS]u8 = undefined;
    for (0..12) |i| {
        const blkno = rd32(&it, loc.off + 40 + i * 4);
        if (blkno == 0) {
            // grow: allocate a block, the new entry spans it whole
            const nb = allocBlock(fs) orelse return false;
            @memset(&blk, 0);
            wr32(&blk, 0, ino);
            wr16(&blk, 4, BS);
            if (fs.filetype) { blk[6] = @intCast(name.len); blk[7] = ftype; }
            else wr16(&blk, 6, @intCast(name.len));
            @memcpy(blk[8 .. 8 + name.len], name);
            if (!writeBlock(fs, nb, &blk)) return false;
            wr32(&it, loc.off + 40 + i * 4, nb);
            wr32(&it, loc.off + 4, rd32(&it, loc.off + 4) + @as(u32, @intCast(BS))); // i_size
            wr32(&it, loc.off + 28, rd32(&it, loc.off + 28) + @as(u32, @intCast(BS / 512)));
            return writeBlock(fs, loc.block, &it);
        }
        if (!readBlock(fs, blkno, &blk)) return false;
        var p: usize = 0;
        while (p < BS) {
            const rec = rd16(&blk, p + 4);
            if (rec < 8) return false;
            const real = (8 + entryNl(fs, &blk, p) + 3) & ~@as(usize, 3);
            if (rec >= real + need) {
                wr16(&blk, p + 4, @intCast(real));
                const e = p + real;
                wr32(&blk, e, ino);
                wr16(&blk, e + 4, @intCast(rec - real));
                if (fs.filetype) { blk[e + 6] = @intCast(name.len); blk[e + 7] = ftype; }
                else wr16(&blk, e + 6, @intCast(name.len));
                @memcpy(blk[e + 8 .. e + 8 + name.len], name);
                return writeBlock(fs, blkno, &blk);
            }
            p += rec;
        }
    }
    return false; // directory out of direct blocks — named bound
}

// Remove `name` from a directory inode. The victim's rec_len folds into
// its in-block predecessor; a block-leading entry has none — its inode
// field zeroes instead (dirFind already skips ino==0 holes). Returns
// the removed entry's inode number — the object survives the name.
fn dirRemove(fs: *Fs, dir_ino: u32, name: []const u8) ?u32 {
    const loc = inodeLoc(fs, dir_ino) orelse return null;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return null;
    if (rd16(&it, loc.off + 0) & 0o170000 != 0o040000) return null;
    var blk: [BS]u8 = undefined;
    for (0..12) |i| {
        const blkno = rd32(&it, loc.off + 40 + i * 4);
        if (blkno == 0) return null;
        if (!readBlock(fs, blkno, &blk)) return null;
        var p: usize = 0;
        var prev: ?usize = null;
        while (p < BS) {
            const rec = rd16(&blk, p + 4);
            if (rec < 8) return null;
            const ino = rd32(&blk, p);
            const nl = entryNl(fs, &blk, p);
            if (ino != 0 and nl == name.len and std.mem.eql(u8, blk[p + 8 .. p + 8 + nl], name)) {
                if (prev) |q| {
                    wr16(&blk, q + 4, rd16(&blk, q + 4) + rec);
                } else {
                    wr32(&blk, p, 0); // block-leading: leave an ino=0 hole
                }
                return if (writeBlock(fs, blkno, &blk)) ino else null;
            }
            prev = p;
            p += rec;
        }
    }
    return null;
}

// ---- inode and block bitmap verbs (multi-group, like create's) -------
// Each verb updates the group-descriptor free count and the superblock
// total, then writes both back — the on-disk counters stay honest.

fn allocInode(fs: *Fs) ?u32 {
    var gdb: [BS]u8 = undefined;
    if (!readBlock(fs, fs.first_data_block + 1, &gdb)) return null;
    const ngroups = fs.inodes_count / fs.inodes_per_group;
    var ib: [BS]u8 = undefined;
    var g: u32 = 0;
    while (g < ngroups) : (g += 1) {
        if (!readBlock(fs, rd32(&gdb, g * 32 + 4), &ib)) return null;
        var i: u32 = if (g == 0) fs.first_ino - 1 else 0;
        while (i < fs.inodes_per_group) : (i += 1) {
            if ((ib[i / 8] & (@as(u8, 1) << @intCast(i % 8))) == 0) {
                ib[i / 8] |= @as(u8, 1) << @intCast(i % 8);
                if (!writeBlock(fs, rd32(&gdb, g * 32 + 4), &ib)) return null;
                wr16(&fs.bgd, g * 32 + 14, rd16(&fs.bgd, g * 32 + 14) - 1);
                if (!writeBlock(fs, fs.first_data_block + 1, &fs.bgd)) return null;
                wr32(&fs.sb, 16, rd32(&fs.sb, 16) - 1);
                if (!writeBlock(fs, 1, &fs.sb)) return null;
                return g * fs.inodes_per_group + i + 1;
            }
        }
    }
    return null;
}

fn freeInode(fs: *Fs, ino: u32) bool {
    const g = (ino - 1) / fs.inodes_per_group;
    const idx = (ino - 1) % fs.inodes_per_group;
    var gdb: [BS]u8 = undefined;
    if (!readBlock(fs, fs.first_data_block + 1, &gdb)) return false;
    var ib: [BS]u8 = undefined;
    if (!readBlock(fs, rd32(&gdb, g * 32 + 4), &ib)) return false;
    ib[idx / 8] &= ~(@as(u8, 1) << @intCast(idx % 8));
    if (!writeBlock(fs, rd32(&gdb, g * 32 + 4), &ib)) return false;
    wr16(&fs.bgd, g * 32 + 14, rd16(&fs.bgd, g * 32 + 14) + 1);
    if (!writeBlock(fs, fs.first_data_block + 1, &fs.bgd)) return false;
    wr32(&fs.sb, 16, rd32(&fs.sb, 16) + 1);
    return writeBlock(fs, 1, &fs.sb);
}

fn allocBlock(fs: *Fs) ?u32 {
    var gdb: [BS]u8 = undefined;
    if (!readBlock(fs, fs.first_data_block + 1, &gdb)) return null;
    const ngroups = fs.inodes_count / fs.inodes_per_group;
    var bb: [BS]u8 = undefined;
    var g: u32 = 0;
    while (g < ngroups) : (g += 1) {
        if (!readBlock(fs, rd32(&gdb, g * 32 + 0), &bb)) return null;
        var j: u32 = 0;
        while (j < fs.blocks_per_group) : (j += 1) {
            if ((bb[j / 8] & (@as(u8, 1) << @intCast(j % 8))) == 0) {
                bb[j / 8] |= @as(u8, 1) << @intCast(j % 8);
                if (!writeBlock(fs, rd32(&gdb, g * 32 + 0), &bb)) return null;
                wr16(&fs.bgd, g * 32 + 12, rd16(&fs.bgd, g * 32 + 12) - 1);
                if (!writeBlock(fs, fs.first_data_block + 1, &fs.bgd)) return null;
                wr32(&fs.sb, 12, rd32(&fs.sb, 12) - 1);
                if (!writeBlock(fs, 1, &fs.sb)) return null;
                return fs.first_data_block + g * fs.blocks_per_group + j;
            }
        }
    }
    return null;
}

fn freeBlock(fs: *Fs, phys: u32) bool {
    const g = (phys - fs.first_data_block) / fs.blocks_per_group;
    const idx = (phys - fs.first_data_block) % fs.blocks_per_group;
    var gdb: [BS]u8 = undefined;
    if (!readBlock(fs, fs.first_data_block + 1, &gdb)) return false;
    var bb: [BS]u8 = undefined;
    if (!readBlock(fs, rd32(&gdb, g * 32 + 0), &bb)) return false;
    bb[idx / 8] &= ~(@as(u8, 1) << @intCast(idx % 8));
    if (!writeBlock(fs, rd32(&gdb, g * 32 + 0), &bb)) return false;
    wr16(&fs.bgd, g * 32 + 12, rd16(&fs.bgd, g * 32 + 12) + 1);
    if (!writeBlock(fs, fs.first_data_block + 1, &fs.bgd)) return false;
    wr32(&fs.sb, 12, rd32(&fs.sb, 12) + 1);
    return writeBlock(fs, 1, &fs.sb);
}

// Free every data block an inode maps: direct pointers, the single-
// indirect table and its leaves. Double-indirect is a named refusal —
// freeing it needs a two-level walk the rung doesn't carry, and the
// callers check before touching any directory entry.
fn fileBlocksFreeable(fs: *Fs, it: []const u8, off: usize) bool {
    _ = fs;
    return rd32(it, off + 40 + 13 * 4) == 0;
}

fn freeFileBlocks(fs: *Fs, it: []const u8, off: usize) bool {
    for (0..12) |i| {
        const b = rd32(it, off + 40 + i * 4);
        if (b != 0 and !freeBlock(fs, b)) return false;
    }
    const ind = rd32(it, off + 40 + 12 * 4);
    if (ind != 0) {
        var tb: [BS]u8 = undefined;
        if (!readBlock(fs, ind, &tb)) return false;
        for (0..BS / 4) |i| {
            const b = rd32(&tb, i * 4);
            if (b != 0 and !freeBlock(fs, b)) return false;
        }
        if (!freeBlock(fs, ind)) return false;
    }
    return true;
}

fn pattern(i: usize) u8 {
    if (i % 64 == 63) return '\n';
    return @intCast('a' + ((i * 7 + i / 1024) % 26));
}

~pub tor mount { id: u32 }
| ok { fs: *Fs<mounted!>, blocks: u32, free_blocks: u32, free_inodes: u32, inodes: u32 }
| refused string

~proc mount|zig {
    const raw = uk_blkdev_get(@intCast(id)) orelse return .{ .refused = "no block device" };
    const pubp: *const BlkPub = @ptrCast(@alignCast(raw));
    const cap = pubp.capabilities;
    if (cap.ssize == 0 or BS % cap.ssize != 0) return .{ .refused = "sector size does not divide 1 KiB" };
    const spb = BS / cap.ssize;
    if (spb > cap.max_sectors_per_req) return .{ .refused = "device cannot transfer one block per request" };
    const conf = BlkConf{ .nb_queues = 1 };
    if (uk_blkdev_configure(raw, &conf) != 0) return .{ .refused = "uk_blkdev_configure failed" };
    var qi = QueueInfo{ .nb_max = 0, .nb_min = 0, .nb_align = 0, .nb_is_power_of_two = 0 };
    if (uk_blkdev_queue_get_info(raw, 0, &qi) != 0) return .{ .refused = "queue_get_info failed" };
    const qc = QueueConf{ .a = _uk_alloc_head, .callback = null, .callback_cookie = null };
    if (uk_blkdev_queue_configure(raw, 0, qi.nb_max, &qc) != 0) return .{ .refused = "queue_configure failed" };
    if (uk_blkdev_start(raw) != 0) return .{ .refused = "uk_blkdev_start failed" };
    const al: usize = if (cap.ioalign < 8) 8 else cap.ioalign;
    const b = memalign(al, BS) orelse return .{ .refused = "out of memory (staging)" };
    const m = malloc(@sizeOf(Fs)) orelse return .{ .refused = "out of memory (fs)" };
    const fs: *Fs = @ptrCast(@alignCast(m));
    fs.dev = raw;
    fs.dev_id = @intCast(id);
    fs.buf = @ptrCast(b);
    fs.spb = spb;
    fs.sectors = cap.sectors;
    if (!readBlock(fs, 1, &fs.sb)) return .{ .refused = "superblock read failed" };
    const sb = &fs.sb;
    if (rd16(sb, 56) != 0xEF53) return .{ .refused = "not ext2 (bad magic)" };
    if (rd32(sb, 24) != 0) return .{ .refused = "block size is not 1 KiB" };
    if (rd32(sb, 76) != 1) return .{ .refused = "not revision 1" };
    if (rd16(sb, 88) != 128) return .{ .refused = "inode size is not 128" };
    const incompat = rd32(sb, 96);
    const ro_compat = rd32(sb, 100);
    if ((incompat & ~@as(u32, 0x2)) != 0) return .{ .refused = "unsupported incompat feature" };
    if ((ro_compat & ~@as(u32, 0x3)) != 0) return .{ .refused = "unsupported ro_compat feature" };
    fs.inodes_count = rd32(sb, 0);
    fs.blocks_count = rd32(sb, 4);
    fs.first_data_block = rd32(sb, 20);
    const bpg = rd32(sb, 32);
    fs.blocks_per_group = bpg;
    fs.inodes_per_group = rd32(sb, 40);
    fs.first_ino = rd32(sb, 84);
    fs.filetype = (incompat & 0x2) != 0;
    // multi-group: reads resolve per-group through the GDT (inodeLoc);
    // the write paths (create/free) still operate on group 0's bitmaps
    // cached below — allocation beyond it is a later rung.
    const ngroups = (fs.blocks_count - fs.first_data_block + bpg - 1) / bpg;
    if (ngroups == 0 or fs.inodes_count != ngroups * fs.inodes_per_group)
        return .{ .refused = "inode/group geometry inconsistent" };
    if (!readBlock(fs, fs.first_data_block + 1, &fs.bgd)) return .{ .refused = "group descriptor read failed" };
    fs.block_bitmap = rd32(&fs.bgd, 0);
    fs.inode_bitmap = rd32(&fs.bgd, 4);
    fs.inode_table = rd32(&fs.bgd, 8);
    fs.vfs = childFs(fs); // the ops record's home is the mount itself
    if (fs.dev_id < mounted.len) mounted[fs.dev_id] = fs;
    return .{ .ok = .{ .fs = fs, .blocks = fs.blocks_count, .free_blocks = rd32(sb, 12), .free_inodes = rd32(sb, 16), .inodes = fs.inodes_count } };
}

~pub tor create { fs: *Fs<!mounted>, name: string, size: u32 }
| ok { fs: *Fs<mounted!>, ino: u32, blocks: u32, first_block: u32 }
| refused { fs: *Fs<mounted!>, reason: string }


~proc create|zig {
    const nblk: u32 = @intCast((@as(usize, size) + BS - 1) / BS);
    if (size == 0 or nblk > 12) return .{ .refused = .{ .fs = fs, .reason = "size must be 1..12 KiB (direct blocks only)" } };
    if (name.len == 0 or name.len > 255) return .{ .refused = .{ .fs = fs, .reason = "bad name length" } };
    var dir: [BS]u8 = undefined;
    if (dirFind(fs, 2, name, &dir) != null) return .{ .refused = .{ .fs = fs, .reason = "name exists" } };

    // inode: scan each group's inode bitmap through the GDT — inos are
    // numbered contiguously across groups (g*ipg + bit + 1).
    var gdb: [BS]u8 = undefined;
    if (!readBlock(fs, fs.first_data_block + 1, &gdb)) return .{ .refused = .{ .fs = fs, .reason = "gdt read failed" } };
    const ngroups = fs.inodes_count / fs.inodes_per_group;
    var ib: [BS]u8 = undefined;
    var ino: u32 = 0;
    var ig: u32 = 0;
    var g: u32 = 0;
    while (g < ngroups and ino == 0) : (g += 1) {
        if (!readBlock(fs, rd32(&gdb, g * 32 + 4), &ib)) return .{ .refused = .{ .fs = fs, .reason = "inode bitmap read failed" } };
        var i: u32 = if (g == 0) fs.first_ino - 1 else 0;
        while (i < fs.inodes_per_group) : (i += 1) {
            if ((ib[i / 8] & (@as(u8, 1) << @intCast(i % 8))) == 0) {
                ino = g * fs.inodes_per_group + i + 1;
                ig = g;
                wr16(&fs.bgd, g * 32 + 14, rd16(&fs.bgd, g * 32 + 14) - 1);
                break;
            }
        }
    }
    if (ino == 0) return .{ .refused = .{ .fs = fs, .reason = "no free inode" } };

    // data blocks: nblk free blocks across groups — each group's bitmap
    // names first_data_block + g*bpg + bit; mark+write back per group.
    var bb: [BS]u8 = undefined;
    var blocks: [12]u32 = [_]u32{0} ** 12;
    var got: u32 = 0;
    g = 0;
    while (g < ngroups and got < nblk) : (g += 1) {
        if (!readBlock(fs, rd32(&gdb, g * 32 + 0), &bb)) return .{ .refused = .{ .fs = fs, .reason = "block bitmap read failed" } };
        const got_before = got;
        var j: u32 = 0;
        while (j < fs.blocks_per_group and got < nblk) : (j += 1) {
            if ((bb[j / 8] & (@as(u8, 1) << @intCast(j % 8))) == 0) {
                bb[j / 8] |= @as(u8, 1) << @intCast(j % 8);
                blocks[got] = fs.first_data_block + g * fs.blocks_per_group + j;
                got += 1;
            }
        }
        if (got > got_before) {
            wr16(&fs.bgd, g * 32 + 12, rd16(&fs.bgd, g * 32 + 12) - @as(u16, @intCast(got - got_before)));
            if (!writeBlock(fs, rd32(&gdb, g * 32 + 0), &bb)) return .{ .refused = .{ .fs = fs, .reason = "bitmap write failed" } };
        }
    }
    if (got < nblk) return .{ .refused = .{ .fs = fs, .reason = "not enough free blocks" } };
    // mark the chosen inode in ITS group's bitmap (ib still holds it)
    ib[(ino - 1 - ig * fs.inodes_per_group) / 8] |= @as(u8, 1) << @intCast((ino - 1) % 8);

    // root directory: split the last entry of the first block
    const need: usize = (8 + name.len + 3) & ~@as(usize, 3);
    var p: usize = 0;
    var last: usize = 0;
    while (p < BS) { last = p; const rec = rd16(&dir, p + 4); if (rec < 8) return .{ .refused = .{ .fs = fs, .reason = "corrupt directory" } }; p += rec; }
    const last_nl: usize = if (fs.filetype) dir[last + 6] else rd16(&dir, last + 6);
    const last_real: usize = (8 + last_nl + 3) & ~@as(usize, 3);
    const last_rec: usize = rd16(&dir, last + 4);
    if (last_rec < last_real + need) return .{ .refused = .{ .fs = fs, .reason = "root directory block full" } };

    // 1. data blocks
    var data: [BS]u8 = undefined;
    var k: u32 = 0;
    while (k < nblk) : (k += 1) {
        @memset(&data, 0);
        var q: usize = 0;
        while (q < BS) : (q += 1) {
            const off = @as(usize, k) * BS + q;
            if (off < size) data[q] = pattern(off);
        }
        if (!writeBlock(fs, blocks[k], &data)) return .{ .refused = .{ .fs = fs, .reason = "data write failed" } };
    }
    // 2. inode
    const loc = inodeLoc(fs, ino) orelse return .{ .refused = .{ .fs = fs, .reason = "inode locate failed" } };
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return .{ .refused = .{ .fs = fs, .reason = "inode table read failed" } };
    @memset(it[loc.off .. loc.off + 128], 0);
    const base = loc.off;
    wr16(&it, base + 0, 0o100644);
    wr32(&it, base + 4, size);
    wr32(&it, base + 8, 1); // atime
    wr32(&it, base + 12, 1); // ctime
    wr32(&it, base + 16, 1); // mtime
    wr16(&it, base + 26, 1); // links
    wr32(&it, base + 28, nblk * @as(u32, @intCast(BS / 512))); // i_blocks in 512 B units
    k = 0;
    while (k < nblk) : (k += 1) wr32(&it, base + 40 + @as(usize, k) * 4, blocks[k]);
    if (!writeBlock(fs, loc.block, &it)) return .{ .refused = .{ .fs = fs, .reason = "inode write failed" } };
    // 3. directory entry
    wr16(&dir, last + 4, @intCast(last_real));
    const e = last + last_real;
    wr32(&dir, e, ino);
    wr16(&dir, e + 4, @intCast(last_rec - last_real));
    if (fs.filetype) { dir[e + 6] = @intCast(name.len); dir[e + 7] = 1; } else wr16(&dir, e + 6, @intCast(name.len));
    @memcpy(dir[e + 8 .. e + 8 + name.len], name);
    var rootino: [BS]u8 = undefined;
    const rl = inodeLoc(fs, 2) orelse return .{ .refused = .{ .fs = fs, .reason = "inode locate failed" } };
    if (!readBlock(fs, rl.block, &rootino)) return .{ .refused = .{ .fs = fs, .reason = "root inode read failed" } };
    if (!writeBlock(fs, rd32(&rootino, rl.off + 40), &dir)) return .{ .refused = .{ .fs = fs, .reason = "directory write failed" } };
    // 4. bitmaps — inode bit goes back to the group it was allocated
    // from (block bitmaps were marked+written per-group during the scan)
    if (!writeBlock(fs, rd32(&gdb, ig * 32 + 4), &ib)) return .{ .refused = .{ .fs = fs, .reason = "bitmap write failed" } };
    // 5. counters: per-group gd entries were decremented during the
    // scan above; the superblock totals fold here, then both write back.
    if (!writeBlock(fs, fs.first_data_block + 1, &fs.bgd)) return .{ .refused = .{ .fs = fs, .reason = "group descriptor write failed" } };
    wr32(&fs.sb, 12, rd32(&fs.sb, 12) - nblk);
    wr32(&fs.sb, 16, rd32(&fs.sb, 16) - 1);
    if (!writeBlock(fs, 1, &fs.sb)) return .{ .refused = .{ .fs = fs, .reason = "superblock write failed" } };
    if (xfer(fs, OP_FFLUSH, 0, 0) != 0) return .{ .refused = .{ .fs = fs, .reason = "flush failed" } };
    return .{ .ok = .{ .fs = fs, .ino = ino, .blocks = nblk, .first_block = blocks[0] } };
}

// A byte buffer handed back across a tor boundary — tor arm fields only
// admit pointers to NAMED types (no slices/optionals/anyopaque), so the
// payload is a named extern struct.
pub const Buf = extern struct { ptr: [*]u8, len: usize };

// lookup: path → inode, the projection's inverse — the inode number is
// the object's stable identity; nid can bind it, exec can take it, and
// the path itself stays a view (renameable, rebindable) not the identity.
~[retain]pub tor lookup { fs: *Fs<!mounted>, path: string }
| ok { fs: *Fs<mounted!>, ino: u32 }
| refused { fs: *Fs<mounted!>, reason: string }

~proc lookup|zig {
    var dir: [BS]u8 = undefined;
    const ino = lookupPath(fs, path, &dir) orelse return .{ .refused = .{ .fs = fs, .reason = "path not found" } };
    return .{ .ok = .{ .fs = fs, .ino = ino } };
}

// path is the POSIX projection: "/bin/child.elf" and "child.elf" both
// walk components from the root — the inode is the identity either way.
~pub tor fetch { fs: *Fs<!mounted>, path: string }
| ok { fs: *Fs<mounted!>, buf: *Buf }
| refused { fs: *Fs<mounted!>, reason: string }

const ReadErr = enum { inode_read, size_range, not_regular, oom, data_read };
const ReadResult = union(enum) { ok: *Buf, err: ReadErr };

fn readErr(e: ReadErr) []const u8 {
    return switch (e) {
        .inode_read => "inode read failed",
        .size_range => "size outside mapped range (>~66 MiB)",
        .not_regular => "not a regular file",
        .oom => "out of memory",
        .data_read => "data read failed",
    };
}

// readFile: inode identity → bytes (direct blocks only). The caller's
// path is a view; the read is always BY INODE — no path string crosses
// this boundary.
// Logical data-block k of an inode → physical block number: direct for
// k<12, single-indirect (i_block[12]) for the next 256, double-indirect
// (i_block[13] → 256×256) to ~66 MiB. Triple-indirect refuses by name.
// Three cached tables: ind = i_block[12], ind2 = i_block[13] root,
// leaf = the current second-level table (reloaded on 256-boundaries).
// A zero block pointer is a sparse HOLE — reads as zeros, not an error;
// `null` is reserved for genuine block-read failures.
fn blkAt(fs: *Fs, it: []const u8, off: usize, k: usize, ind: *[BS]u8, ind2: *[BS]u8, leaf: *[BS]u8, st: *[4]u32) ?u32 {
    if (k < 12) return rd32(it, off + 40 + k * 4);
    const cap1 = 12 + BS / 4;
    if (k < cap1) {
        if (st[0] == 0) {
            const ib = rd32(it, off + 40 + 12 * 4);
            if (ib == 0) return 0;
            if (!readBlock(fs, ib, ind)) return null;
            st[0] = 1;
        }
        return rd32(ind, (k - 12) * 4);
    }
    const d = k - cap1;
    if (d >= (BS / 4) * (BS / 4)) return null;
    if (st[1] == 0) {
        const ib = rd32(it, off + 40 + 13 * 4);
        if (ib == 0) return 0;
        if (!readBlock(fs, ib, ind2)) return null;
        st[1] = 1;
    }
    const li = d / (BS / 4);
    if (st[2] != li + 1) { // cached leaf is a different table — reload
        const lvl2 = rd32(ind2, li * 4);
        if (lvl2 == 0) return 0;
        if (!readBlock(fs, lvl2, leaf)) return null;
        st[2] = @intCast(li + 1);
    }
    return rd32(leaf, (d % (BS / 4)) * 4);
}

fn readFile(fs: *Fs, ino: u32) ReadResult {
    const loc = inodeLoc(fs, ino) orelse return .{ .err = .inode_read };
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return .{ .err = .inode_read };
    const fsize = rd32(&it, loc.off + 4);
    if (fsize == 0 or fsize > (12 + BS / 4 + (BS / 4) * (BS / 4)) * BS) return .{ .err = .size_range };
    const mode = rd16(&it, loc.off + 0);
    if (mode & 0o170000 != 0o100000) return .{ .err = .not_regular };
    const mem = malloc(fsize) orelse return .{ .err = .oom };
    const bh = malloc(@sizeOf(Buf)) orelse {
        free(mem);
        return .{ .err = .oom };
    };
    const bp: *Buf = @ptrCast(@alignCast(bh));
    bp.* = .{ .ptr = @ptrCast(mem), .len = fsize };
    const out: [*]u8 = @ptrCast(mem);
    var data: [BS]u8 = undefined;
    var ind: [BS]u8 = undefined;
    var ind2: [BS]u8 = undefined;
    var leaf: [BS]u8 = undefined;
    var st = [4]u32{ 0, 0, 0, 0 };
    var off: usize = 0;
    var k: usize = 0;
    while (off < fsize) : (k += 1) {
        const phys = blkAt(fs, &it, loc.off, k, &ind, &ind2, &leaf, &st) orelse {
            free(mem);
            free(bh);
            return .{ .err = .data_read };
        };
        if (phys == 0) { // sparse hole — zeros, not a read
            @memset(out[off..@min(off + BS, fsize)], 0);
            off = @min(off + BS, fsize);
            continue;
        }
        if (!readBlock(fs, phys, &data)) {
            free(mem);
            free(bh);
            return .{ .err = .data_read };
        }
        var q: usize = 0;
        while (q < BS and off < fsize) : ({ q += 1; off += 1; }) out[off] = data[q];
    }
    return .{ .ok = bp };
}

// ---- the child's fs view ---------------------------------------------------
// When this fs spawns a child, the child's open/read/close syscalls
// resolve INSIDE this same ext2 — the scoped fs view. The seam calls
// back through this ops record (koru/native's ChildFsOps ABI); a file
// handle is an allocated OpenFile whose pointer is the kernel fd's
// cargo. The view is writable now — mutation is the seam's to gate (fd
// verbs at open, W-grants on the mutated directory), the provider's to
// execute. Reads are still by-inode underneath — paths are a view
// (lookupPath), I/O is always inode+offset.

// A handle is refcounted: fork and spawn fd-wiring dup it (share the
// offset — POSIX), so close frees only when the last reference drops.
const OpenFile = struct { ino: u32, size: u32, pos: u64, refs: u32, mode: u8, append: bool };

const ChildFsOps = extern struct {
    ctx: ?*anyopaque,
    // open(path, flags): linux flag word — O_ACCMODE in the low bits,
    // O_CREAT/O_TRUNC/O_APPEND in the upper. Write modes mint a handle
    // the seam must have already gated (fdverbs + object W grant).
    open: *const fn (ctx: ?*anyopaque, path: [*:0]const u8, flags: c_int) callconv(.c) i64,
    read: *const fn (ctx: ?*anyopaque, h: u64, dst: [*]u8, len: usize) callconv(.c) i64,
    read_at: *const fn (ctx: ?*anyopaque, h: u64, off: u64, dst: [*]u8, len: usize) callconv(.c) i64,
    seek: *const fn (ctx: ?*anyopaque, h: u64, off: i64, whence: u32) callconv(.c) i64,
    stat: *const fn (ctx: ?*anyopaque, h: u64, dst: [*]u8) callconv(.c) i64,
    close: *const fn (ctx: ?*anyopaque, h: u64) callconv(.c) void,
    // dup bumps the handle's provider-side refcount and returns the
    // handle to record — fork and spawn-fd-wiring SHARE the open file
    // (POSIX: one offset across dup'd fds), so close must refcount, not
    // free on the first drop.
    dup: *const fn (ctx: ?*anyopaque, h: u64) callconv(.c) i64,
    // key(path) → the object key (dev<<32|ino) WITHOUT a handle — the
    // seam's pre-open grant check resolves the object (or the parent
    // directory for O_CREAT) before any handle exists.
    key: *const fn (ctx: ?*anyopaque, path: [*:0]const u8) callconv(.c) i64,
    write: *const fn (ctx: ?*anyopaque, h: u64, src: [*]const u8, len: usize) callconv(.c) i64,
    rename: *const fn (ctx: ?*anyopaque, old: [*:0]const u8, new: [*:0]const u8) callconv(.c) i64,
    unlink: *const fn (ctx: ?*anyopaque, path: [*:0]const u8) callconv(.c) i64,
    // open_key(key, flags): open by OBJECT IDENTITY — no path is
    // walked. The key's dev must name this fs (a key from another
    // device is EXDEV, never resolved to a local inode); the inode
    // must be a live regular file.
    open_key: *const fn (ctx: ?*anyopaque, key: u64, flags: c_int) callconv(.c) i64,
};

// readAt: inode + byte-range → bytes, reading only the blocks covered —
// what a child read(2)/pread(2) actually costs. Whole-file readFile
// stays for exec/pin/fetch.
fn readAt(fs: *Fs, ino: u32, off: u64, dst: [*]u8, len: usize) i64 {
    const loc = inodeLoc(fs, ino) orelse return -5;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return -5; // EIO
    const fsize: u64 = rd32(&it, loc.off + 4);
    if (off >= fsize) return 0;
    const n: usize = @intCast(@min(fsize - off, len));
    var ind: [BS]u8 = undefined;
    var ind2: [BS]u8 = undefined;
    var leaf: [BS]u8 = undefined;
    var st = [4]u32{ 0, 0, 0, 0 };
    var data: [BS]u8 = undefined;
    var done: usize = 0;
    while (done < n) {
        const k: usize = @intCast((off + done) / BS);
        const phys = blkAt(fs, &it, loc.off, k, &ind, &ind2, &leaf, &st) orelse return @intCast(done);
        const boff: usize = @intCast((off + done) % BS);
        const take = @min(n - done, BS - boff);
        if (phys == 0) { // sparse hole — zeros
            @memset(dst[done .. done + take], 0);
        } else {
            if (!readBlock(fs, phys, &data)) return -5;
            @memcpy(dst[done .. done + take], data[boff .. boff + take]);
        }
        done += take;
    }
    return @intCast(done);
}

// mkfile: a fresh regular inode linked into dir_ino — the O_CREAT
// half of open. Shares create()'s allocation machinery: inode bitmap
// scan, dir entry insert; blocks stay unallocated (size 0) — writes
// grow it later, on demand.
fn mkfile(fs: *Fs, dir_ino: u32, name: []const u8) ?u32 {
    const ino = allocInode(fs) orelse return null;
    const loc = inodeLoc(fs, ino) orelse return null;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return null;
    @memset(it[loc.off .. loc.off + 128], 0);
    wr16(&it, loc.off + 0, 0o100644);
    wr16(&it, loc.off + 26, 1); // links
    if (!writeBlock(fs, loc.block, &it)) return null;
    if (!dirAdd(fs, dir_ino, name, ino, 1)) {
        _ = freeInode(fs, ino); // the entry didn't land — give the ino back
        return null;
    }
    return ino;
}

// truncate: O_TRUNC's arm — give back every block the file maps, leave
// the inode at size 0. Same freeable-check as unlink: double-indirect
// refuses BEFORE any state moves.
fn truncateFile(fs: *Fs, loc: anytype, it: *[BS]u8) bool {
    if (!fileBlocksFreeable(fs, it, loc.off)) return false;
    if (!freeFileBlocks(fs, it, loc.off)) return false;
    for (0..15) |i| wr32(it, loc.off + 40 + i * 4, 0);
    wr32(it, loc.off + 4, 0);
    wr32(it, loc.off + 28, 0);
    return writeBlock(fs, loc.block, it);
}

// musl flag word (linux): accmode 3, O_CREAT 0100, O_EXCL 0200,
// O_TRUNC 01000, O_APPEND 02000 — the subset the view serves.
const O_CREAT: c_int = 0o100;
const O_EXCL: c_int = 0o200;
const O_TRUNC: c_int = 0o1000;
const O_APPEND: c_int = 0o2000;

fn cfOpen(ctx: ?*anyopaque, path: [*:0]const u8, flags: c_int) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    const mode: u8 = @intCast(flags & 3); // 0=R, 1=W, 2=RW
    var dir: [BS]u8 = undefined;
    const p = std.mem.span(path);
    var ino = lookupPath(fs, p, &dir);
    if (ino == null) {
        // O_CREAT: the mutated object is the parent directory — create
        // the inode + the name inside it.
        if ((flags & O_CREAT) == 0) return -2; // ENOENT
        const sp = splitPath(p);
        const dino = lookupPath(fs, sp.dir, &dir) orelse return -2;
        ino = mkfile(fs, dino, sp.leaf) orelse return -5; // EIO covers the named bounds
    } else if ((flags & O_CREAT) != 0 and (flags & O_EXCL) != 0) {
        return -17; // EEXIST
    }
    const loc = inodeLoc(fs, ino.?) orelse return -5;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return -5;
    if (rd16(&it, loc.off) & 0o170000 != 0o100000) return -21; // EISDIR
    if ((flags & O_TRUNC) != 0 and mode != 0) {
        if (!truncateFile(fs, loc, &it)) return -38; // ENOSYS-class bound (double-ind)
    }
    const h = malloc(@sizeOf(OpenFile)) orelse return -12; // ENOMEM
    const fp: *OpenFile = @ptrCast(@alignCast(h));
    const size = if ((flags & O_TRUNC) != 0 and mode != 0) 0 else rd32(&it, loc.off + 4);
    fp.* = .{ .ino = ino.?, .size = size,
               .pos = if ((flags & O_APPEND) != 0) size else 0,
               .refs = 1, .mode = mode, .append = (flags & O_APPEND) != 0 };
    return @intCast(@intFromPtr(fp));
}

fn cfRead(ctx: ?*anyopaque, h: u64, dst: [*]u8, len: usize) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    const fp: *OpenFile = @ptrFromInt(@as(usize, @intCast(h)));
    if (fp.mode == 1) return -9; // EBADF — a write-only handle has no read verb
    const n = readAt(fs, fp.ino, fp.pos, dst, len);
    if (n > 0) fp.pos += @intCast(n);
    return n;
}

fn cfReadAt(ctx: ?*anyopaque, h: u64, off: u64, dst: [*]u8, len: usize) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    const fp: *OpenFile = @ptrFromInt(@as(usize, @intCast(h)));
    return readAt(fs, fp.ino, off, dst, len);
}

// cfWrite: inode + byte-range ← bytes. The bounded write contract:
// direct blocks only — a write that lands past 12 KiB of file span
// refuses ENOSPC by name (single-indirect allocation is a named cell).
// Within the bound: missing blocks allocate on demand (sparse growth),
// partial blocks read-modify-write, i_size/i_blocks fold back. The
// provider never checks the verb — the seam's fdverbs did that at open;
// a read-mode handle arriving here is defense-in-depth EBADF.
fn cfWrite(ctx: ?*anyopaque, h: u64, src: [*]const u8, len: usize) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    const fp: *OpenFile = @ptrFromInt(@as(usize, @intCast(h)));
    if (fp.mode == 0) return -9; // EBADF — a read handle has no write verb
    const start: u64 = if (fp.append) fp.size else fp.pos;
    const loc = inodeLoc(fs, fp.ino) orelse return -5;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return -5;
    var data: [BS]u8 = undefined;
    var done: usize = 0;
    var grew: u32 = 0;
    while (done < len) {
        const k: usize = @intCast((start + done) / BS);
        if (k >= 12) return if (done > 0) @intCast(done) else -28; // ENOSPC — direct blocks only
        var phys = rd32(&it, loc.off + 40 + k * 4);
        const boff: usize = @intCast((start + done) % BS);
        const take = @min(len - done, BS - boff);
        if (phys == 0) {
            phys = allocBlock(fs) orelse return if (done > 0) @intCast(done) else -28;
            wr32(&it, loc.off + 40 + k * 4, phys);
            grew += 1;
            @memset(&data, 0);
        } else if (boff != 0 or take < BS) {
            if (!readBlock(fs, phys, &data)) return -5;
        } else {
            @memset(&data, 0); // whole block overwritten — no read needed
        }
        @memcpy(data[boff .. boff + take], src[done .. done + take]);
        if (!writeBlock(fs, phys, &data)) return -5;
        done += take;
    }
    const end = start + done;
    if (end > fp.size) fp.size = @intCast(end);
    if (grew != 0) wr32(&it, loc.off + 28, rd32(&it, loc.off + 28) + grew * @as(u32, @intCast(BS / 512)));
    wr32(&it, loc.off + 4, fp.size);
    if (!writeBlock(fs, loc.block, &it)) return -5;
    fp.pos = end;
    return @intCast(done);
}

fn cfKey(ctx: ?*anyopaque, path: [*:0]const u8) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    var dir: [BS]u8 = undefined;
    const ino = lookupPath(fs, std.mem.span(path), &dir) orelse return -2; // ENOENT
    return @bitCast((@as(u64, fs.dev_id) << 32) | ino);
}

// cfOpenKey: identity → handle, skipping the directory walk entirely.
// This is the object axis' open: a child that names the key never
// touches a path — and the seam's grant names the same key.
fn cfOpenKey(ctx: ?*anyopaque, key: u64, flags: c_int) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    if (key >> 32 != fs.dev_id) return -18; // EXDEV — not this provider's object
    const ino: u32 = @intCast(key & 0xFFFFFFFF);
    if (ino < fs.first_ino or ino > fs.inodes_count) return -2; // ENOENT
    const loc = inodeLoc(fs, ino) orelse return -5;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return -5;
    const mode = rd16(&it, loc.off);
    if (mode == 0 or rd16(&it, loc.off + 26) == 0) return -2; // freed inode — ENOENT
    if (mode & 0o170000 != 0o100000) return -21; // EISDIR
    const h = malloc(@sizeOf(OpenFile)) orelse return -12;
    const fp: *OpenFile = @ptrCast(@alignCast(h));
    const amode: u8 = @intCast(flags & 3);
    fp.* = .{ .ino = ino, .size = rd32(&it, loc.off + 4),
               .pos = if ((flags & O_APPEND) != 0) rd32(&it, loc.off + 4) else 0,
               .refs = 1, .mode = amode, .append = (flags & O_APPEND) != 0 };
    return @intCast(@intFromPtr(fp));
}

// doRename shared by the tor and the child view: remove the source
// name, re-link the SAME inode under the new name — identity is the
// inode, the names are directory entries pointing at it. Replacing an
// existing regular-file destination unlinks it first (POSIX replace);
// a directory destination refuses — rmdir is a named cell, not a
// silent verb.
fn doRename(fs: *Fs, oldp: []const u8, newp: []const u8) i64 {
    var dir: [BS]u8 = undefined;
    const osp = splitPath(oldp);
    const nsp = splitPath(newp);
    if (nsp.leaf.len == 0) return -22; // EINVAL — no leaf to rename onto
    const sdir = lookupPath(fs, osp.dir, &dir) orelse return -2;
    const ndir = lookupPath(fs, nsp.dir, &dir) orelse return -2;
    const vict = dirFind(fs, sdir, osp.leaf, &dir) orelse return -2; // ENOENT
    const loc = inodeLoc(fs, vict) orelse return -5;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return -5;
    const vmode = rd16(&it, loc.off);
    const ftype: u8 = if (vmode & 0o170000 == 0o040000) 2 else 1;
    // destination already linked: same inode → nop (POSIX); a file →
    // unlink it; a dir → EISDIR, this rung doesn't serve rmdir.
    if (dirFind(fs, ndir, nsp.leaf, &dir)) |dst| {
        if (dst == vict) return 0;
        const dloc = inodeLoc(fs, dst) orelse return -5;
        var dit: [BS]u8 = undefined;
        if (!readBlock(fs, dloc.block, &dit)) return -5;
        if (rd16(&dit, dloc.off) & 0o170000 == 0o040000) return -21; // EISDIR
        if (!fileBlocksFreeable(fs, &dit, dloc.off)) return -38;
        _ = dirRemove(fs, ndir, nsp.leaf) orelse return -5;
        if (!freeFileBlocks(fs, &dit, dloc.off) or !freeInode(fs, dst)) return -5;
    }
    if (!dirAdd(fs, ndir, nsp.leaf, vict, ftype)) return -12; // ENOMEM-class
    _ = dirRemove(fs, sdir, osp.leaf);
    if (xfer(fs, OP_FFLUSH, 0, 0) != 0) return -5;
    return 0;
}

fn cfRename(ctx: ?*anyopaque, old: [*:0]const u8, new: [*:0]const u8) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    return doRename(fs, std.mem.span(old), std.mem.span(new));
}

// cfUnlink: remove a name; when the link count reaches zero the inode
// and its blocks return to the bitmaps. Regular files only — a dir is
// EISDIR, not a silent recurse. Double-indirect content refuses BEFORE
// the directory entry moves — the refusal leaves the fs untouched.
fn cfUnlink(ctx: ?*anyopaque, path: [*:0]const u8) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    var dir: [BS]u8 = undefined;
    const sp = splitPath(std.mem.span(path));
    const dino = lookupPath(fs, sp.dir, &dir) orelse return -2;
    const vict = dirFind(fs, dino, sp.leaf, &dir) orelse return -2;
    const loc = inodeLoc(fs, vict) orelse return -5;
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return -5;
    if (rd16(&it, loc.off) & 0o170000 == 0o040000) return -21; // EISDIR
    if (!fileBlocksFreeable(fs, &it, loc.off)) return -38;
    _ = dirRemove(fs, dino, sp.leaf) orelse return -5;
    const links = rd16(&it, loc.off + 26) - 1;
    if (links == 0) {
        if (!freeFileBlocks(fs, &it, loc.off) or !freeInode(fs, vict)) return -5;
    } else {
        wr16(&it, loc.off + 26, links);
        if (!writeBlock(fs, loc.block, &it)) return -5;
    }
    if (xfer(fs, OP_FFLUSH, 0, 0) != 0) return -5;
    return 0;
}

fn cfSeek(ctx: ?*anyopaque, h: u64, off: i64, whence: u32) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    _ = fs;
    const fp: *OpenFile = @ptrFromInt(@as(usize, @intCast(h)));
    const base: i64 = switch (whence) {
        0 => 0,
        1 => @intCast(fp.pos),
        2 => fp.size,
        else => return -22, // EINVAL
    };
    const np = base + off;
    if (np < 0) return -22;
    fp.pos = @intCast(np);
    return np;
}

fn cfStat(ctx: ?*anyopaque, h: u64, dst: [*]u8) callconv(.c) i64 {
    const fs: *Fs = @ptrCast(@alignCast(ctx));
    const fp: *OpenFile = @ptrFromInt(@as(usize, @intCast(h)));
    for (0..144) |i| dst[i] = 0;
    const w64 = struct { // little-endian u64 write into the stat buffer
        fn s(b: [*]u8, off: usize, v: u64) void {
            for (0..8) |i| b[off + i] = @truncate(v >> @intCast(i * 8));
        }
    }.s;
    w64(dst, 0, fs.dev_id);                          // st_dev
    w64(dst, 8, fp.ino);                             // st_ino
    w64(dst, 16, 1);                                 // st_nlink
    for (0..4) |i| dst[24 + i] = @truncate(@as(u64, 0o100644) >> @intCast(i * 8)); // st_mode u32
    w64(dst, 48, fp.size);                           // st_size
    w64(dst, 56, BS);                                // st_blksize
    w64(dst, 64, (fp.size + 511) / 512);             // st_blocks
    return 0;
}

fn cfClose(ctx: ?*anyopaque, h: u64) callconv(.c) void {
    _ = ctx;
    const fp: *OpenFile = @ptrFromInt(@as(usize, @intCast(h)));
    if (fp.refs > 0) fp.refs -= 1;
    if (fp.refs == 0) free(fp);
}

// dup: same handle, +1 ref — the child shares the file (one offset),
// and each table's close drops exactly its own reference.
fn cfDup(ctx: ?*anyopaque, h: u64) callconv(.c) i64 {
    _ = ctx;
    const fp: *OpenFile = @ptrFromInt(@as(usize, @intCast(h)));
    fp.refs += 1;
    return @bitCast(h);
}

fn childFs(fs: *Fs) ChildFsOps {
    return .{ .ctx = @ptrCast(fs), .open = cfOpen, .read = cfRead,
              .read_at = cfReadAt, .seek = cfSeek, .stat = cfStat, .close = cfClose,
              .dup = cfDup, .key = cfKey, .write = cfWrite,
              .rename = cfRename, .unlink = cfUnlink, .open_key = cfOpenKey };
}

~proc fetch|zig {
    var dir: [BS]u8 = undefined;
    const ino = lookupPath(fs, path, &dir) orelse return .{ .refused = .{ .fs = fs, .reason = "path not found" } };
    return switch (readFile(fs, ino)) {
        .ok => |bp| .{ .ok = .{ .fs = fs, .buf = bp } },
        .err => |e| .{ .refused = .{ .fs = fs, .reason = readErr(e) } },
    };
}

// exec: the full fold — path (a view) → inode (the identity) → ELF
// bytes → a ring-3 process via the same seam spawn:exec uses. The tor
// returns the identity it executed: the inode, and the object-nid
// BOUND in koruos/nid's object-pin store under the foreign name
// ext2/d<dev>/<ino>. The nid lift owns minting — a program using exec
// must carry koruos/nid or the link refuses the missing symbols.
// koru_spawn_elf's 4th arg scopes the child's fs view: exec hands the
// child THIS fs — open/read/close inside it resolve by path+inode
// through the ops record above. Hosted providers export the 3-arg
// spelling (the arg is ignored there — a hosted child has no scoped fs).
extern fn koru_spawn_elf(image: [*]const u8, size: usize, rights: u64, fsv: ?*const ChildFsOps) c_int;
extern var child_arg0: [64]u8;
extern fn koruos_nid_obj_pin(foreign: [*:0]const u8, key: u64) u64;
extern fn koruos_nid_obj_key(nid: u64) i64;
extern fn koruos_nid_obj_foreign(nid: u64, out: [*]u8, cap: usize) i64;

// argv[0] for the next spawn: the exec'd path's basename — POSIX's own
// convention (argv0 is the name the program was invoked as; for a
// multi-call binary like busybox it IS the program selection).
fn setArg0(path: []const u8) void {
    const name = if (std.mem.lastIndexOfScalar(u8, path, '/')) |i| path[i + 1 ..] else path;
    @memset(&child_arg0, 0);
    @memcpy(child_arg0[0..@min(name.len, 63)], name[0..@min(name.len, 63)]);
}

// pinNid: bind (dev, ino) in the nid store; the key packs both halves so
// resolve can verify the object is on THIS fs. nid==0 is the store's
// refusal (collision, key-conflict, or full).
fn pinNid(fs: *Fs, ino: u32) u64 {
    var fbuf: [64]u8 = undefined;
    const foreign = std.fmt.bufPrintZ(&fbuf, "ext2/d{d}/{d}", .{ fs.dev_id, ino }) catch return 0;
    return koruos_nid_obj_pin(foreign, (@as(u64, fs.dev_id) << 32) | ino);
}

~[retain]pub tor exec { fs: *Fs<!mounted>, path: string, rights: u64 }
| ok { fs: *Fs<mounted!>, status: i64, ino: u32, nid: u64 }
| refused { fs: *Fs<mounted!>, reason: string }

~proc exec|zig {
    var dir: [BS]u8 = undefined;
    const ino = lookupPath(fs, path, &dir) orelse return .{ .refused = .{ .fs = fs, .reason = "path not found" } };
    const nid = pinNid(fs, ino);
    if (nid == 0) return .{ .refused = .{ .fs = fs, .reason = "nid store refused the pin" } };
    const bp = switch (readFile(fs, ino)) {
        .ok => |b| b,
        .err => |e| return .{ .refused = .{ .fs = fs, .reason = readErr(e) } },
    };
    setArg0(path);
    const st = koru_spawn_elf(@ptrCast(bp.ptr), bp.len, rights, &fs.vfs);
    free(@ptrCast(bp.ptr));
    free(@ptrCast(bp));
    if (st < 0) return .{ .refused = .{ .fs = fs, .reason = "spawn provider refused the image" } };
    return .{ .ok = .{ .fs = fs, .status = st, .ino = ino, .nid = nid } };
}

// pin: path → bound identity, without executing — the explicit
// "give me this object's nid" surface for resolvers and later rename.
~[retain]pub tor pin { fs: *Fs<!mounted>, path: string }
| ok { fs: *Fs<mounted!>, ino: u32, nid: u64 }
| refused { fs: *Fs<mounted!>, reason: string }

~proc pin|zig {
    var dir: [BS]u8 = undefined;
    const ino = lookupPath(fs, path, &dir) orelse return .{ .refused = .{ .fs = fs, .reason = "path not found" } };
    const nid = pinNid(fs, ino);
    if (nid == 0) return .{ .refused = .{ .fs = fs, .reason = "nid store refused the pin" } };
    return .{ .ok = .{ .fs = fs, .ino = ino, .nid = nid } };
}

// rename: mutate the view, never the identity — a directory entry moves
// and the inode it names does not change, so a pin bound before the
// rename resolves the same object after it. That is the durability
// claim the boot fixture proves end-to-end.
~pub tor rename { fs: *Fs<!mounted>, old: string, new: string }
| ok *Fs<mounted!>
| refused { fs: *Fs<mounted!>, reason: string }

~proc rename|zig {
    const r = doRename(fs, old, new);
    if (r < 0) return .{ .refused = .{ .fs = fs, .reason = switch (r) {
        -2 => "path not found", -21 => "destination is a directory",
        -22 => "no leaf to rename onto", -38 => "object not freeable (double-indirect)",
        else => "rename failed",
    } } };
    return .{ .ok = fs };
}

// exec-nid: exec by identity — no path is walked. The nid resolves to
// the pinned (dev, ino) key in koruos/nid's store; a nid bound on a
// different device is refused by name, never resolved to a local inode.
~[retain]pub tor exec-nid { fs: *Fs<!mounted>, nid: u64, rights: u64 }
| ok { fs: *Fs<mounted!>, status: i64, ino: u32 }
| refused { fs: *Fs<mounted!>, reason: string }

~proc exec-nid|zig {
    const key = koruos_nid_obj_key(nid);
    if (key < 0) return .{ .refused = .{ .fs = fs, .reason = "nid not bound to an object" } };
    const k: u64 = @bitCast(key);
    if (k >> 32 != fs.dev_id) return .{ .refused = .{ .fs = fs, .reason = "nid bound on another device" } };
    const ino: u32 = @intCast(k & 0xFFFFFFFF);
    const bp = switch (readFile(fs, ino)) {
        .ok => |b| b,
        .err => |e| return .{ .refused = .{ .fs = fs, .reason = readErr(e) } },
    };
    setArg0("exec-nid");
    const st = koru_spawn_elf(@ptrCast(bp.ptr), bp.len, rights, &fs.vfs);
    free(@ptrCast(bp.ptr));
    free(@ptrCast(bp));
    if (st < 0) return .{ .refused = .{ .fs = fs, .reason = "spawn provider refused the image" } };
    return .{ .ok = .{ .fs = fs, .status = st, .ino = ino } };
}

// exec-by-nid: exec by identity ALONE — no caller-held fs. The pin
// resolves the provider: the walk is two tables — nid → key
// (dev<<32|ino) and the foreign name in koruos/nid's object store, then
// dev → the live mounted Fs in this lift's `mounted` registry. The
// foreign name must carry this provider's scheme and its device must
// still be mounted — a pin that survives an unmount refuses by name,
// never runs a dead provider's ops record. The child's fs view is
// &fs.vfs: the mount's own record, alive exactly as long as the mount.
~[retain]pub tor exec-by-nid { nid: u64, rights: u64 }
| ok { status: i64, dev: u32, ino: u32 }
| refused string

// resolvePin: nid → the live mounted Fs + inode — the shared walk
// behind exec-by-nid and every obj-* verb. Two tables: the pin store
// (nid → key + foreign name) then the mounted registry (dev → *Fs).
// Every miss refuses by name — never a dead provider's ops record.
const PinErr = enum { unbound, unreadable, scheme, unmounted };

fn resolvePin(nid: u64) union(enum) { ok: struct { fs: *Fs, ino: u32 }, err: PinErr } {
    const key = koruos_nid_obj_key(nid);
    if (key < 0) return .{ .err = .unbound };
    var fb: [64]u8 = undefined;
    const fl = koruos_nid_obj_foreign(nid, &fb, fb.len);
    if (fl < 0) return .{ .err = .unreadable };
    if (!std.mem.startsWith(u8, fb[0..@intCast(fl)], "ext2/"))
        return .{ .err = .scheme };
    const k: u64 = @bitCast(key);
    const dev: u32 = @intCast(k >> 32);
    if (dev >= mounted.len or mounted[dev] == null)
        return .{ .err = .unmounted };
    return .{ .ok = .{ .fs = mounted[dev].?, .ino = @intCast(k & 0xFFFFFFFF) } };
}

fn pinErr(e: PinErr) []const u8 {
    return switch (e) {
        .unbound => "nid not bound to an object",
        .unreadable => "nid's foreign name unreadable",
        .scheme => "nid pins a scheme this provider does not serve",
        .unmounted => "nid's provider is not mounted",
    };
}

~proc exec-by-nid|zig {
    const r = switch (resolvePin(nid)) {
        .ok => |v| v,
        .err => |e| return .{ .refused = pinErr(e) },
    };
    const fs = r.fs;
    const dev = fs.dev_id;
    const ino = r.ino;
    const bp = switch (readFile(fs, ino)) {
        .ok => |b| b,
        .err => |e| return .{ .refused = readErr(e) },
    };
    setArg0("exec-by-nid");
    const st = koru_spawn_elf(@ptrCast(bp.ptr), bp.len, rights, &fs.vfs);
    free(@ptrCast(bp.ptr));
    free(@ptrCast(bp));
    if (st < 0) return .{ .refused = "spawn provider refused the image" };
    return .{ .ok = .{ .status = st, .dev = dev, .ino = ino } };
}

// ---- object verbs — the fs.object half of this provider ---------------
// The object axis, callable: a nid names the object, these verbs act on
// it. No path is ever walked — the pin resolves provider+inode through
// resolvePin, the verb goes by-inode. A rename BETWEEN pin and obj-read
// is invisible to the caller: identity, not view.

// obj-read: nid + offset → {n, first4} — flat fields (a returned Buf
// would leak and the .k tier prints flat). first4 is the first ≤4
// bytes packed LE — for an ELF it IS the magic, proof bytes ride home.
~pub tor obj-read { nid: u64, off: u64, len: u32 }
| ok { n: i64, first4: u32 }
| refused string

~proc obj-read|zig {
    const r = switch (resolvePin(nid)) {
        .ok => |v| v,
        .err => |e| return .{ .refused = pinErr(e) },
    };
    var tmp: [64]u8 = undefined;
    if (len > tmp.len) return .{ .refused = "obj-read bound is 64 bytes" };
    const n = readAt(r.fs, r.ino, off, &tmp, len);
    if (n < 0) return .{ .refused = "object read failed" };
    var f4: u32 = 0;
    var i: usize = 0;
    while (i < @min(@as(usize, @intCast(n)), 4)) : (i += 1)
        f4 |= @as(u32, tmp[i]) << @intCast(8 * i);
    return .{ .ok = .{ .n = n, .first4 = f4 } };
}

// obj-stat: nid → the object's descriptor — the proof surface for
// "the pin still names what you pinned".
~pub tor obj-stat { nid: u64 }
| ok { dev: u32, ino: u32, size: u32, mode: u16 }
| refused string

~proc obj-stat|zig {
    const r = switch (resolvePin(nid)) {
        .ok => |v| v,
        .err => |e| return .{ .refused = pinErr(e) },
    };
    const loc = inodeLoc(r.fs, r.ino) orelse return .{ .refused = "inode locate failed" };
    var it: [BS]u8 = undefined;
    if (!readBlock(r.fs, loc.block, &it)) return .{ .refused = "inode read failed" };
    return .{ .ok = .{ .dev = r.fs.dev_id, .ino = r.ino,
                       .size = rd32(&it, loc.off + 4), .mode = rd16(&it, loc.off) } };
}

// obj-write: nid + offset + bytes → count — mutation BY IDENTITY.
// Direct blocks only (cfWrite's bound); a write past 12 KiB of span is
// ENOSPC by name.
~pub tor obj-write { nid: u64, off: u64, buf: *Buf }
| ok i64
| refused string

~proc obj-write|zig {
    const r = switch (resolvePin(nid)) {
        .ok => |v| v,
        .err => |e| return .{ .refused = pinErr(e) },
    };
    const fs = r.fs;
    const loc = inodeLoc(fs, r.ino) orelse return .{ .refused = "inode locate failed" };
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return .{ .refused = "inode read failed" };
    if (rd16(&it, loc.off) & 0o170000 != 0o100000) return .{ .refused = "not a regular file" };
    var data: [BS]u8 = undefined;
    var done: usize = 0;
    var size = rd32(&it, loc.off + 4);
    var grew: u32 = 0;
    while (done < buf.len) {
        const k: usize = @intCast((off + done) / BS);
        if (k >= 12) return .{ .refused = "past direct-block span (ENOSPC)" };
        var phys = rd32(&it, loc.off + 40 + k * 4);
        const boff: usize = @intCast((off + done) % BS);
        const take = @min(buf.len - done, BS - boff);
        if (phys == 0) {
            phys = allocBlock(fs) orelse return .{ .refused = "out of blocks" };
            wr32(&it, loc.off + 40 + k * 4, phys);
            grew += 1;
            @memset(&data, 0);
        } else if (boff != 0 or take < BS) {
            if (!readBlock(fs, phys, &data)) return .{ .refused = "data read failed" };
        } else {
            @memset(&data, 0);
        }
        @memcpy(data[boff .. boff + take], buf.ptr[done .. done + take]);
        if (!writeBlock(fs, phys, &data)) return .{ .refused = "data write failed" };
        done += take;
    }
    const end = off + done;
    if (end > size) size = @intCast(end);
    if (grew != 0) wr32(&it, loc.off + 28, rd32(&it, loc.off + 28) + grew * @as(u32, @intCast(BS / 512)));
    wr32(&it, loc.off + 4, size);
    if (!writeBlock(fs, loc.block, &it)) return .{ .refused = "inode write failed" };
    if (xfer(fs, OP_FFLUSH, 0, 0) != 0) return .{ .refused = "flush failed" };
    return .{ .ok = @intCast(done) };
}

~pub tor verify { fs: *Fs<!mounted>, path: string, size: u32 }
| ok { fs: *Fs<mounted!>, ino: u32, bytes: u32 }
| mismatch { fs: *Fs<mounted!>, reason: string }

~proc verify|zig {
    var dir: [BS]u8 = undefined;
    const ino = lookupPath(fs, path, &dir) orelse return .{ .mismatch = .{ .fs = fs, .reason = "path not found" } };
    const loc = inodeLoc(fs, ino) orelse return .{ .mismatch = .{ .fs = fs, .reason = "inode locate failed" } };
    var it: [BS]u8 = undefined;
    if (!readBlock(fs, loc.block, &it)) return .{ .mismatch = .{ .fs = fs, .reason = "inode read failed" } };
    const fsize = rd32(&it, loc.off + 4);
    if (fsize != size) return .{ .mismatch = .{ .fs = fs, .reason = "size differs" } };
    var data: [BS]u8 = undefined;
    var off: usize = 0;
    var k: usize = 0;
    while (off < fsize) : (k += 1) {
        if (!readBlock(fs, rd32(&it, loc.off + 40 + k * 4), &data)) return .{ .mismatch = .{ .fs = fs, .reason = "data read failed" } };
        var q: usize = 0;
        while (q < BS and off < fsize) : ({ q += 1; off += 1; }) {
            if (data[q] != pattern(off)) return .{ .mismatch = .{ .fs = fs, .reason = "content differs" } };
        }
    }
    return .{ .ok = .{ .fs = fs, .ino = ino, .bytes = fsize } };
}

~[retain]pub tor unmount { fs: *Fs<!mounted> }
| ok
| failed string

~proc unmount|zig {
    const dev = fs.dev;
    if (fs.dev_id < mounted.len) mounted[fs.dev_id] = null; // before the free
    free(@ptrCast(fs.buf));
    free(@ptrCast(fs));
    if (uk_blkdev_stop(dev) != 0) return .{ .failed = "uk_blkdev_stop failed" };
    if (uk_blkdev_queue_unconfigure(dev, 0) != 0) return .{ .failed = "queue_unconfigure failed" };
    if (uk_blkdev_unconfigure(dev) != 0) return .{ .failed = "uk_blkdev_unconfigure failed" };
    return .{ .ok = .{} };
}
