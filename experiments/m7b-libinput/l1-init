#!/bin/busybox sh
# M7b L1 oracle init: Linux 6.12 (i8042/atkbd built in, evdev.ko, bochs-drm), real
# systemd-udevd 257 to produce the udev database (or, with /etc/libudev-zero, no udevd and
# libudev-zero as libudev.so.1), then libinput debug-events (path backend)
# under strace (file syscalls), keys injected by the host (drive.py).
/bin/busybox --install -s /bin
mount -t devtmpfs dev /dev; mount -t proc proc /proc; mount -t sysfs sys /sys
mkdir -p /run; mount -t tmpfs run /run
insmod /ko/evdev.ko; for m in $(cat /modorder.txt); do insmod /ko/$m.ko; done
if [ -e /etc/libudev-zero ]; then echo "l1-init: libudev-zero, no udevd"
else /usr/lib/systemd/systemd-udevd --daemon; udevadm trigger --action=add; udevadm settle; fi
EV=/dev/input/$(for e in /sys/class/input/event*; do grep -q "AT Translated" $e/device/name && basename $e; done)
echo "l1-init: keyboard $EV"
for f in /run/udev/data/c13:* /run/udev/data/c226:0; do echo "==== UDEVDB $f"; cat $f; echo "==== END"; done
/bin/udevprobe; echo "l1-init: udevprobe exit status $?"
for d in /sys/devices/platform/i8042/serio0/input/input0/event0 /sys/devices/platform/i8042/serio0/input/input0 \
  /sys/devices/platform/i8042/serio0 /sys/devices/platform/i8042 /sys/devices/platform /sys/devices/virtual/dmi/id \
  $(readlink -f /sys/class/drm/card0) $(readlink -f /sys/class/drm/card0/device); do
  echo "==== UEVENT $d"; cat $d/uevent; echo "SUBSYSTEM-LINK $(readlink $d/subsystem)"; echo "==== END"; done
ls -l /sys/dev/char/13:64 /sys/dev/char/226:0 /sys/class/input/event0 /sys/class/drm/card0
echo "m7b-init: start"
strace -f -e trace=%file,getdents64,socket,connect,bind,ioctl -o /tmp/li.strace \
  /usr/bin/libinput debug-events --show-keycodes --device $EV &
SP=$!; sleep 30; echo "m7b-init: stopping $(pidof libinput-debug-events) (strace $SP)"
kill -INT $(pidof libinput-debug-events); sleep 3; kill -9 $(pidof libinput-debug-events) $SP 2>/dev/null; sleep 1
echo "m7b-init: libinput stopped"
echo "==== STRACE libinput"; grep -v -E '\.so|/usr/share/libinput/|/(lib|usr/lib)/x86_64' /tmp/li.strace; echo "==== END libinput"
echo "l1-init: done"
poweroff -f
