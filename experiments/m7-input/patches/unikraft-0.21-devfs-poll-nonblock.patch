+/* koru-os M7: dispatch poll to the device if it implements it; otherwise keep
+ * the old behaviour (no events reported).
+ */
+static int
+devfs_poll(struct vnode *vp, unsigned int *revents, struct eventpoll_cb *ecb)
+{
+	struct device *dev = (struct device *)vp->v_data;
+
+	if (vp->v_type == VDIR || !dev)
+		return 0;
+	if (!dev->driver || !dev->driver->devops || !dev->driver->devops->poll)
+		return 0;
+	return dev->driver->devops->poll(dev, revents, ecb);
+}
 
