@@ -315,7 +315,15 @@
 #define devfs_rmdir	((vnop_rmdir_t)vfscore_vop_einval)
 #define devfs_setattr	((vnop_setattr_t)vfscore_vop_eperm)
 #define devfs_inactive	((vnop_inactive_t)vfscore_vop_nullop)
-#define devfs_truncate	((vnop_truncate_t)vfscore_vop_nullop)
+/* koru-os M9: ftruncate() records the size in the vnode (memfds, lib/korumemfd);
+ * other devices ignore it as before */
+static int devfs_truncate(struct vnode *vp, off_t length)
+{
+	if (length < 0)
+		return EINVAL;
+	vp->v_size = length;
+	return 0;
+}
